<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agenda_fundo"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="start"
            android:text="Your Day!"
            android:textColor="@color/agenda_verde"
            android:textSize="52sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:labelFor="@id/editNome"
            android:text="Como você quer ser chamado?"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
        <EditText
            android:id="@+id/editNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/cartao_agenda"
            android:hint="Digite seu nome"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            android:singleLine="true"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComecar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="22dp"
            android:padding="16dp"
            android:text="Comece a organizar seu dia →"
            android:textAllCaps="false"
            android:textColor="@color/agenda_tinta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/acao_principal" />
    </LinearLayout>
</ScrollView>
