<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/cartao_agenda"
    android:paddingEnd="8dp"
    android:paddingStart="4dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <CheckBox
        android:id="@+id/checkTarefa"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:button="@drawable/check_tarefa"
        android:buttonTint="@null"
        android:layout_marginStart="4dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textNomeTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/agenda_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/textHorarioTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/textStatusTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textPrioridade"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>
    <Button
        android:id="@+id/acoesTarefa"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:minHeight="48dp"
        android:text="@string/acoes"
        android:textAllCaps="false"
        android:textColor="@color/agenda_verde" />
</LinearLayout>
