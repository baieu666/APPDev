<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <EditText
            android:id="@+id/editNomeTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="Nome da tarefa"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:singleLine="true" />
        <Button
            android:id="@+id/btnDataTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="Escolher data"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/btnHoraTarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Escolher horário limite"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prioridade"
            android:labelFor="@id/prioridade"
            android:layout_marginTop="16dp" />
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/prioridade"
            android:entries="@array/niveis_prioridade"
            android:minHeight="48dp" />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/adicionarOutra"
            android:text="@string/salvar_e_adicionar"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
