<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/agenda_fundo">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="Your Day!"
                    android:textColor="@color/agenda_verde"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/escolherTema"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tema"
                    android:textAllCaps="false"
                    android:textColor="@color/agenda_verde" />
            </LinearLayout>
            <Button
                android:id="@+id/configurarLembretes"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/lembretes_desligados"
                android:textAllCaps="false"
                android:textColor="@color/agenda_verde" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <include layout="@layout/avatar_perfil" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/textSaudacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/agenda_texto"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/abrirPerfil"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/meu_perfil"
                        android:textAllCaps="false"
                        android:textColor="@color/agenda_verde" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/cartao_agenda">
                <Button
                    android:id="@+id/diaAnterior"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/agenda_texto"
                    android:textSize="28sp"
                    android:text="‹"
                    android:contentDescription="Dia anterior" />
                <Button
                    android:id="@+id/escolherData"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/agenda_texto"
                    android:textSize="15sp"
                    android:layout_weight="1"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawableTint="@color/agenda_texto"
                    android:contentDescription="Escolher data no calendário" />
                <Button
                    android:id="@+id/proximoDia"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/agenda_texto"
                    android:textSize="28sp"
                    android:text="›"
                    android:contentDescription="Próximo dia" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/painel_progresso"
                android:padding="18dp"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/progresso_dia"
                        android:textColor="@color/agenda_texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textProgresso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/agenda_verde"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/barraProgresso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/agenda_verde"
                    android:progressBackgroundTint="@color/agenda_trilho" />
                <TextView
                    android:id="@+id/textResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Tarefas do dia"
                android:textColor="@color/agenda_texto"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/filtrarTarefas"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textColor="@color/agenda_verde" />
            <TextView
                android:id="@+id/textSemTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sem_tarefas_no_dia"
                android:visibility="gone"
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"
                android:background="@drawable/cartao_agenda"
                android:padding="20dp" />
            <LinearLayout
                android:id="@+id/listaTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAdicionarTarefa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="+ Adicionar tarefa"
        android:textAllCaps="false"
        android:textColor="@color/agenda_tinta"
        android:textSize="18sp"
        android:background="@drawable/acao_principal"
        android:textStyle="bold" />
</LinearLayout>
